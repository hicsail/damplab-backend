# ─── Database ────────────────────────────────────────────────────────────────
# `docker compose up -d` publishes Mongo on :27017, the Mongo default.
#
# If something already owns 27017 — a native `mongod` from
# `brew install mongodb-community` is the usual culprit — set MONGO_HOST_PORT
# instead of editing docker-compose.yml; compose reads it from this file.
# Keep MONGO_URI's port in step, and export MONGO_TEST_URI to match before
# running `npm run test:integration` (jest does not read this file).
#   MONGO_HOST_PORT=27018
#   MONGO_URI=mongodb://localhost:27018/damplab
#   export MONGO_TEST_URI=mongodb://localhost:27018/damplab_itest
MONGO_URI=mongodb://localhost:27017/damplab
PORT=5100

# ─── Auth ────────────────────────────────────────────────────────────────────
# Keycloak JWKS endpoint used to verify incoming JWTs.
JWKS_ENDPOINT=

# ─── Local auth bypass (development only) ────────────────────────────────────
# Both halves must be set, and VITE_DEV_AS_ROLES in damplab-ui/.env must match
# DEV_AS_ROLES exactly. THIS value is the one that decides what `myPermissions`
# returns and what every server-side gate resolves against; the frontend's copy
# only drives the staff flag and the role chips. When they drift, the browser
# console logs an error at startup. See CANVAS/CLAUDE.md, "Local auth bypass".
DISABLE_AUTH=false
# Comma-separated. Empty resolves to the client baseline. Unset defaults to
# damplab-staff. Worth walking: damplab-staff, technician,
# client-unassisted-equipment-user, and empty.
DEV_AS_ROLES=damplab-staff

# Registers the dev-only clearDatabase / loadData GraphQL mutations. They DROP the
# database. Off by default; nothing in the repo calls them.
ENABLE_RESET_MODULE=false

# ─── Keycloak Admin API ──────────────────────────────────────────────────────
# Used to fetch staff group members for the lab-monitor assignee dropdown and
# Customer Management's STAFF filter.
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=damplab
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Comma-separated. Defaults to damplab-staff,technician. The older singular
# KEYCLOAK_LAB_STAFF_GROUP_NAME is still read as a fallback.
KEYCLOAK_LAB_STAFF_GROUP_NAMES=damplab-staff,technician

# ─── protocols.io ────────────────────────────────────────────────────────────
# Protocol content is fetched server-side; only IDs are stored in the DB.
PROTOCOLS_IO_API_KEY=
PROTOCOLS_IO_API_BASE_URL=
PROTOCOLS_IO_CLIENT_ID=
PROTOCOLS_IO_CLIENT_SECRET=

# ─── ClickUp (bug backlog) ───────────────────────────────────────────────────
CLICKUP_API_TOKEN=
CLICKUP_BUG_LIST_ID=
CLICKUP_API_BASE_URL=
CLICKUP_LIST_CACHE_SECONDS=

# ─── n8n webhooks ────────────────────────────────────────────────────────────
N8N_AGENT_WEBHOOK_URL=
N8N_AGENT_WEBHOOK_SECRET=
N8N_LAB_STATUS_WEBHOOK_URL=
N8N_BUG_TRIAGE_WEBHOOK_URL=

# ─── AWS S3 (job / bug-report attachments) ───────────────────────────────────
JOB_ATTACHMENTS_BUCKET=
JOB_ATTACHMENTS_UPLOAD_URL_TTL=

# ─── Notifications (Mailgun email) ────────────────────────────────────────────
# Email notifications are OFF by default. Set NOTIFICATION_EMAIL_ENABLED=true
# once Mailgun is configured and tested in staging.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.sail.codes
MAILGUN_FROM_ADDRESS=DampLab <noreply@mail.sail.codes>
NOTIFICATION_EMAIL_ENABLED=false
APP_BASE_URL=https://damplab-canvas.sail.codes

# ─── Health thresholds ───────────────────────────────────────────────────────
STORAGE_THRESHOLD=0.75
MEMORY_THRESHOLD=104857600
